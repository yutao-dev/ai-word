{
  "name": "ai-word-monorepo",
  "version": "1.0.0",
  "description": "AI Word - 智能文档创作助手 (前后端分离架构)",
  "scripts": {
    "dev": "powershell -File ./start-dev.ps1",
    "install:all": "powershell -File ./install-deps.ps1",
